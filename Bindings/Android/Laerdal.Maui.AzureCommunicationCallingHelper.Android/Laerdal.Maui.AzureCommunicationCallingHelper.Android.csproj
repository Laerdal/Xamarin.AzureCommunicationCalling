<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
      <PackageId>Laerdal.Maui.AzureCommunicationHelper.android</PackageId>
      <version>2.13.0-beta.1.3</version>
      <TargetFrameworks>net8.0-android</TargetFrameworks>
      <Nullable>enable</Nullable>
      <ImplicitUsings>true</ImplicitUsings>
      <IsBindingProject>true</IsBindingProject>
      <AssemblyName>Laerdal.Maui.AzureCommunicationCallingHelper.Android</AssemblyName>
      <Title>AzureCoreLogging for NET</Title>
      <Authors>Laerdal Medical</Authors>
      <Description>
        This  nuget is a horrible hack to solve the problem of ACS using retrofuture in its
        public facing API, which I never managed to bind...

        The nuget contains a few static methods, basically just exposing all the retrofutures
        from ACS as regular methods...
      </Description>
      <PackagesReleaseNotes>
          2.13.0-beta.1
      </PackagesReleaseNotes>
      <Copyright>Copyright Laerdal Medical 2024</Copyright>
      <RepositoryUrl>https://github.com/laerdal/Xamarin.AzureCommunicationCalling</RepositoryUrl>
      <ProjectUrl>https://github.com/laerdal/Xamarin.AzureCommunicationCalling</ProjectUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageTags>Maui Azure Android</PackageTags>
      <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
  <ItemGroup>
    <AndroidLibrary Include="Jars\AzureCommunicationCallingHelper-release.aar"/>
  </ItemGroup>
     <ItemGroup>
     <PackageReference Include="Laerdal.Maui.AzureCommunicationCalling.android" Version="2.13.0-beta.1.3" />
   </ItemGroup>
</Project>
