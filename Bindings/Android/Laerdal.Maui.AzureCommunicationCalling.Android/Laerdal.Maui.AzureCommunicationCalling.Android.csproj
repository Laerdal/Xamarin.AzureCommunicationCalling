<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
      <PackageId>Laerdal.Maui.AzureCommunicationCalling.android</PackageId>
      <version>2.16.0.1</version>
      <TargetFrameworks>net9.0-android</TargetFrameworks>
      <Nullable>enable</Nullable>
      <ImplicitUsings>true</ImplicitUsings>
      <IsBindingProject>true</IsBindingProject>
      <AssemblyName>Laerdal.Maui.AzureCommunicationCalling.Android</AssemblyName>
      <Title>AzureCommunicationCalling for net9.0-android</Title>
      <Authors>Laerdal Medical</Authors>
      <Description>
          Binding for Azure Communication Calling library for Android.
          
          This nuget is just a binding library for this native Android library : https://search.maven.org/artifact/com.azure.android/azure-communication-calling
      </Description>
      <PackageReleaseNotes>
          2.16.0
      </PackageReleaseNotes>
      <Copyright>Copyright Laerdal Medical 2024</Copyright>
      <RepositoryUrl>https://github.com/laerdal/Xamarin.AzureCommunicationCalling</RepositoryUrl>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageTags>Maui Azure Communication Android</PackageTags>
      <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
      <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Laerdal.Maui.AzureCommunicationCommon.Android" Version="1.2.1.4" />
    <PackageReference Include="Laerdal.Maui.TrouterClient.Android" Version="1.0.0.0" />
  </ItemGroup>
  <ItemGroup>
    <AndroidLibrary Include="Jars\azure-communication-calling-2.16.0.aar"/>
  </ItemGroup>
  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
    <TransformFile Include="Transforms\EnumFields.xml" />
    <TransformFile Include="Transforms\EnumMethods.xml" />
  </ItemGroup>
</Project>
